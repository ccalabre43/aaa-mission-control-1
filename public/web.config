<?xml version="1.0" encoding="utf-8"?>
<!--
  IIS configuration for Mission Control.

  Requires the IIS URL Rewrite module. Without it IIS returns HTTP 500.19 on startup rather than
  silently ignoring the rules, so a missing module fails loudly instead of producing an app whose
  deep links 404.

  Deploying under a virtual application or subdirectory: build with APP_BASE_PATH set to that path
  and place this file at the root of that application, not the site root. The rewrite target below
  is relative, so it resolves inside the application either way.

  The Content-Security-Policy below must stay in step with public/_headers, vercel.json,
  public/staticwebapp.config.json, and public/.htaccess.
-->
<configuration>
  <system.webServer>
    <rewrite>
      <rules>
        <rule name="SPA history fallback" stopProcessing="true">
          <match url=".*" />
          <conditions logicalGrouping="MatchAll">
            <!-- Real files and directories win, so hashed assets are served normally. -->
            <add input="{REQUEST_FILENAME}" matchType="IsFile" negate="true" />
            <add input="{REQUEST_FILENAME}" matchType="IsDirectory" negate="true" />
          </conditions>
          <action type="Rewrite" url="index.html" />
        </rule>
      </rules>
    </rewrite>

    <httpProtocol>
      <customHeaders>
        <!-- Remove first: IIS inherits customHeaders from parent config, and a duplicate
             Content-Security-Policy header is treated as the intersection of both policies, which
             produces breakage that looks nothing like a config error. -->
        <remove name="Content-Security-Policy" />
        <remove name="Referrer-Policy" />
        <remove name="X-Content-Type-Options" />
        <remove name="Permissions-Policy" />
        <remove name="Cross-Origin-Opener-Policy" />
        <remove name="X-Powered-By" />
        <add name="Content-Security-Policy" value="default-src 'self'; script-src 'self'; style-src 'self'; font-src 'self'; img-src 'self' data:; connect-src 'self'; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'" />
        <add name="Referrer-Policy" value="no-referrer" />
        <add name="X-Content-Type-Options" value="nosniff" />
        <add name="Permissions-Policy" value="camera=(), microphone=(), geolocation=()" />
        <add name="Cross-Origin-Opener-Policy" value="same-origin" />
      </customHeaders>
    </httpProtocol>

    <staticContent>
      <!-- Older IIS installs have no MIME type for woff2 and answer 404 for the self-hosted fonts,
           which then silently fall back to a system font. -->
      <remove fileExtension=".woff2" />
      <mimeMap fileExtension=".woff2" mimeType="font/woff2" />
      <remove fileExtension=".woff" />
      <mimeMap fileExtension=".woff" mimeType="font/woff" />
      <remove fileExtension=".json" />
      <mimeMap fileExtension=".json" mimeType="application/json" />
    </staticContent>

    <security>
      <requestFiltering>
        <!-- The other hosts' config files ship in the same folder and are meaningless to IIS.
             Refusing to serve them keeps the deployment from advertising its own plumbing. -->
        <hiddenSegments>
          <add segment="_headers" />
          <add segment="_redirects" />
          <add segment="staticwebapp.config.json" />
        </hiddenSegments>
      </requestFiltering>
    </security>
  </system.webServer>
</configuration>
