# Apache configuration for Mission Control.
#
# Requires mod_rewrite and AllowOverride FileInfo (or All) on the directory. If AllowOverride is
# None, Apache ignores this file entirely and deep links 404 with no error anywhere - so confirm it
# is being read rather than assuming, by requesting /request directly after deploying.
#
# Serving under a subdirectory: build with APP_BASE_PATH set to that path and change RewriteBase to
# match. RewriteBase is the one value here that does not adapt on its own.
#
# The Content-Security-Policy below must stay in step with public/_headers, vercel.json,
# public/staticwebapp.config.json, and public/web.config.

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # Real files and directories win, so hashed assets in /assets/ are served normally.
  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]

  # Everything else is a client-side route. Internal rewrite, not a redirect: the address bar must
  # keep the path the user asked for or the router cannot restore it.
  RewriteRule ^ index.html [L]
</IfModule>

<IfModule mod_headers.c>
  Header always unset Content-Security-Policy
  Header always set Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self'; font-src 'self'; img-src 'self' data:; connect-src 'self'; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'"
  Header always set Referrer-Policy "no-referrer"
  Header always set X-Content-Type-Options "nosniff"
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=()"
  Header always set Cross-Origin-Opener-Policy "same-origin"

  # Matched on path, not extension: only Vite's fingerprinted output is safe to cache forever. An
  # extension match would also freeze an unhashed file such as /robots.txt, which does change.
  # Unanchored so this still works when the app is served from a subdirectory.
  SetEnvIf Request_URI "/assets/" AAA_IMMUTABLE=1
  Header set Cache-Control "public, max-age=31536000, immutable" env=AAA_IMMUTABLE
  <FilesMatch "^index\.html$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
</IfModule>

<IfModule mod_mime.c>
  AddType font/woff2 .woff2
  AddType font/woff .woff
</IfModule>

# The other hosts' config files are meaningless to Apache and need not be readable.
<FilesMatch "^(_headers|_redirects|staticwebapp\.config\.json|web\.config)$">
  Require all denied
</FilesMatch>
