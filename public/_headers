# Netlify response headers.
#
# The Content-Security-Policy here is the canonical policy. It is duplicated into vercel.json,
# staticwebapp.config.json, public/web.config, and public/.htaccess because each host reads its own
# format and there is no shared include. Project convention: update all of them or none.
# See docs/deployment.md for the policy rationale and how it was verified.

/*
  Content-Security-Policy: default-src 'self'; script-src 'self'; style-src 'self'; font-src 'self'; img-src 'self' data:; connect-src 'self'; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'
  Referrer-Policy: no-referrer
  X-Content-Type-Options: nosniff
  Permissions-Policy: camera=(), microphone=(), geolocation=()
  Cross-Origin-Opener-Policy: same-origin

# Vite fingerprints every file in /assets/, so the content of a given URL never changes and it can
# be cached hard. index.html must not be, or a returning user keeps loading the old bundle and its
# now-deleted asset URLs after a deploy.
/assets/*
  Cache-Control: public, max-age=31536000, immutable

/index.html
  Cache-Control: no-cache
