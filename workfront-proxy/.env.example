# Copy to the repo root as .env.workfront.local (gitignored). Never commit secrets.
# For Adobe Runtime deploy, set the same names as aio / Developer Console secrets — not VITE_*.

WORKFRONT_CLIENT_ID=
WORKFRONT_CLIENT_SECRET=
WORKFRONT_HOST=https://aaalife.my.workfront.com
WORKFRONT_PROJECT_ID=6abae2b600041e3ecb6a8da4dbe7b4a1

# Portfolio ID for TEST PORTFOLIO - CHRIS (Portfolio Optimization # / drag order on Executive).
# Never VITE_*. Find it on the Portfolio details URL or API — not the project ID above.
# WORKFRONT_PORTFOLIO_ID=

# Local-only fallback when you already have a short-lived IMS access token from Developer Console
# "Generate access token" and have not yet put the client secret into Runtime. Do not use in
# production Runtime; prefer CLIENT_ID + CLIENT_SECRET.
# WORKFRONT_ACCESS_TOKEN=

# Kill switch for dual-write POST /issues, /priority, /documents, /portfolio. Off unless explicitly set.
# WORKFRONT_LIVE_SUBMIT=1

# Optional overrides
# WORKFRONT_IMS_SCOPE=openid,session,profile,AdobeID,additional_info.roles,read_organizations,additional_info.projectedProductContext
# WORKFRONT_PROXY_PORT=8787
