# Copy to .env for local overrides. .env itself is gitignored.
#
# Never put a secret in a VITE_-prefixed variable. Vite compiles those into the public client
# bundle, where anyone who loads the page can read them. Server-side secrets belong behind a proxy.
# APP_BASE_PATH and WORKFRONT_PROXY_URL are read by vite.config.ts at build time and are
# deliberately not VITE_-prefixed. Workfront client_secret belongs in .env.workfront.local (local
# proxy) or Adobe Runtime secrets — see workfront-proxy/README.md.

# Where the app is served from. Leave unset or "/" for a domain root.
# For a subpath deployment such as https://intranet/creative/ use "/creative/".
# A leading and trailing slash are added if you leave them off.
APP_BASE_PATH=/

# Public URL of the Workfront health proxy (Adobe Runtime web action). Leave unset in local
# development so the app calls same-origin /api/workfront (Vite forwards to WORKFRONT_PROXY_TARGET).
# WORKFRONT_PROXY_URL=https://adobeioruntime.net/api/v1/web/.../mission-control/workfront-health

# Where Vite proxies /api/workfront during npm run dev / preview. Defaults to the local stand-in.
# WORKFRONT_PROXY_TARGET=http://127.0.0.1:8787

# Workfront secrets (including WORKFRONT_PORTFOLIO_ID for Portfolio Optimization order) belong in
# .env.workfront.local or Vercel/Runtime env — never VITE_*. See workfront-proxy/.env.example.

# Deep Dive SharePoint Excel proxy (Graph secrets in .env.deep-dive.local — never VITE_*).
# DEEP_DIVE_PROXY_TARGET=http://127.0.0.1:8788
# See deep-dive-proxy/.env.example and docs/knowledge/deep-dive-excel.md.
