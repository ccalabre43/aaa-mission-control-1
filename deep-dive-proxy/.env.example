# Copy to ../.env.deep-dive.local (gitignored). Never commit secrets. Never VITE_*.

# Kill switch: set to 1 only after Vendor Management + privacy clear PII writes (decision 044/046).
DEEP_DIVE_LIVE_WRITE=0

# Microsoft Graph — delegated user token OR app client credentials (server only).
# Prefer a short-lived GRAPH_ACCESS_TOKEN for local verify; rotate if pasted in chat.
# GRAPH_ACCESS_TOKEN=

# App-only (optional). Requires Sites.Selected or broader Graph consent on the Azure app.
# GRAPH_TENANT_ID=
# GRAPH_CLIENT_ID=
# GRAPH_CLIENT_SECRET=

# Workbook identifiers from Composio / Graph discovery (see docs/knowledge/deep-dive-excel.md).
# Graph site_id form: hostname,siteCollectionId,webId
# GRAPH_SITE_ID=
# GRAPH_DRIVE_ID=
# GRAPH_ITEM_ID=
# Worksheet name or id (e.g. Sheet1)
# GRAPH_WORKSHEET_ID=Sheet1

# Optional: override listen port (default 8788). Vite forwards /api/deep-dive here.
# DEEP_DIVE_PROXY_PORT=8788
